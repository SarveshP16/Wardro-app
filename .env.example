# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string used by Prisma. Matches the `db` service in
# docker-compose.yml by default — only change the host/credentials if you
# change that service.
DATABASE_URL="postgresql://wardro:wardro@db:5432/wardro?schema=public"

# Anthropic API key for the AI Stylist. Server-side only — never sent to
# the browser. Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Internal URL of the rembg sidecar (the `rembg` service in
# docker-compose.yml). Only change this for local dev outside Docker.
REMBG_URL="http://rembg:8000"

# Where the Android app finds this server -- your Docker host as seen from
# your phone over Tailscale (Tailscale IP or MagicDNS name, plus the port).
# Only read when building the APK (`npm run android:apk`), not by Docker.
WARDRO_SERVER_URL="http://my-pc:3000"

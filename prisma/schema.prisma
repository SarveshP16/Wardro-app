// Wardro data model.
// No `imagePath` column: a ClothingItem's `id` *is* the image filename
// (`data/images/<id>.png`, written by lib/imageStore.ts), so there's no
// path to drift out of sync with the file on disk.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7+: the connection URL lives in prisma.config.ts (for Migrate)
// and is passed to the PrismaClient constructor via a driver adapter
// (for the app itself) -- see lib/db.ts. Nothing to put here anymore.
datasource db {
  provider = "postgresql"
}

enum Category {
  TOP
  BOTTOM
  OUTERWEAR
  SHOES
  DRESS
  SKIRT
  JUMPSUIT
}

enum Style {
  CASUAL
  SMART_CASUAL
  FORMAL
  EVENING
  WORK
  INTERVIEW
  DATE_NIGHT
  PARTY
  WEDDING_GUEST
  ACTIVE
  TRAVEL
  BEACH
  LOUNGE
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

// A person using Wardro -- picked by name on the profile screen (no
// password: access control is the Tailscale network, see README). Each
// profile has its own wardrobe, saved outfits, and theme. The active
// profile is remembered per device in a cookie (see lib/profile.ts).
model Profile {
  id        String   @id @default(uuid())
  name      String   @unique
  // Avatar color key -- one of PROFILE_COLORS in lib/types.ts.
  color     String
  // 'system' | 'light' | 'dark'.
  themeMode String   @default("system")
  // Visual style: 'navy' (Tailor's navy) | 'colour' (Colour story) --
  // see LOOKS in lib/types.ts.
  look      String   @default("navy")
  // Which clothing categories to offer: 'all' | 'women' | 'men' -- 'men'
  // hides dresses, skirts and jumpsuits (see lib/categories.ts).
  gender    String   @default("all")
  createdAt DateTime @default(now())

  items       ClothingItem[]
  outfits     SavedOutfit[]
  suggestions SuggestedOutfit[]
}

model ClothingItem {
  id            String   @id @default(uuid())
  profileId     String
  // One or more, stored in canonical order (see lib/categories.ts) -- e.g.
  // an overshirt can be both a top and outerwear. The first is the piece's
  // main category (icon, default name).
  categories    Category[]
  name          String?
  // Packed 0xRRGGBB, or null for items whose dominant color hasn't been
  // computed.
  dominantColor Int?
  createdAt     DateTime @default(now())

  profile     Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  outfitLinks SavedOutfitItem[]

  @@index([profileId])
}

model SavedOutfit {
  id        String   @id @default(uuid())
  profileId String
  style     Style
  // null means the outfit was generated/saved without a season filter
  // ("Any season").
  season    Season?
  title     String
  rationale String
  createdAt DateTime @default(now())

  profile Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items   SavedOutfitItem[]

  @@index([profileId])
}

// Join table preserving each item's position within the outfit.
model SavedOutfitItem {
  outfitId String
  itemId   String
  position Int

  outfit SavedOutfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  item   ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([outfitId, itemId])
}

// Every outfit the AI Stylist has shown a profile, so it never suggests
// the same combination twice (see app/api/outfits/generate/ai/route.ts).
// `signature` is the sorted item-id list (lib/outfitSignature.ts) rather
// than a relation: rows for outfits whose items were deleted just never
// match again.
model SuggestedOutfit {
  profileId String
  signature String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, signature])
  @@index([profileId, createdAt])
}

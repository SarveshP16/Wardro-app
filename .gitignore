# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files -- never commit real secrets (ANTHROPIC_API_KEY, DATABASE_URL).
# See .env.example for the template.
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# user-uploaded wardrobe images (local dev only -- Docker uses a named
# volume instead, see docker-compose.yml)
/data/images/

# IDE
.idea/
*.iml

# Android: generated from WARDRO_SERVER_URL by scripts/android-prepare.mjs
/android-shell/config.js

# Android release signing -- never commit these; losing them means you can
# never ship an update to the installed app, so back them up privately.
*.jks
*.keystore
android/keystore.properties

# local database backups (pg_dump) -- personal data, never commit
/*.sql

# personal to-do list -- local only
/TODO.md
